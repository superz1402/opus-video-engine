{
 "b001": {
  "dur": 15.67,
  "text": "\u0938\u094c \u0930\u093e\u0924\u094b\u0902 \u0915\u0940 \u0924\u0940\u0938\u0930\u0940 \u0930\u093e\u0924\u0964 \u0938\u094b\u091a\u094b, \u0924\u0941\u092e \u0918\u0928\u0947 \u091c\u0902\u0917\u0932 \u092e\u0947\u0902 \u0939\u094b\u2026 \u0914\u0930 \u0905\u0901\u0927\u0947\u0930\u093e \u0939\u094b\u0924\u0947 \u0939\u0940 \u092a\u0947\u0921\u093c\u094b\u0902 \u0938\u0947 \u092e\u093e\u0901 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0924\u0940 \u0939\u0948 \u2014 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092a\u0941\u0915\u093e\u0930\u0924\u0940 \u0939\u0941\u0908\u0964 \u0932\u0947\u0915\u093f\u0928 \u092e\u093e\u0901 \u0924\u094b \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u092e\u0940\u0932 \u0926\u0942\u0930 \u0939\u0948\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 17.476,
  "text": "\u0926 \u092e\u093f\u092e\u093f\u0915\u0964 \u0907\u0938\u0915\u093e \u091a\u0947\u0939\u0930\u093e \u0928\u0939\u0940\u0902, \u0907\u0938\u0932\u093f\u090f \u092f\u0939 \u0935\u0939\u0940 \u0909\u0927\u093e\u0930 \u0932\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u091a\u093e\u0939\u093f\u090f \u2014 \u090f\u0915 \u0906\u0935\u093e\u091c\u093c \u091c\u093f\u0938 \u092a\u0930 \u0924\u0941\u092e \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u0926\u093f\u0928 \u092d\u0930 \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u0938\u0940\u0916\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u0909\u0938 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0915\u0948\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948\u0964",
  "start": 16.02
 },
 "b003": {
  "dur": 17.79,
  "text": "\u0924\u0940\u0928 \u092e\u0939\u093e\u0926\u094d\u0935\u0940\u092a\u094b\u0902, \u090f\u0915 \u0939\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u092a\u0947\u0921\u093c\u094b\u0902 \u0938\u0947 \u0928\u093e\u092e \u092a\u0941\u0915\u093e\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u092d\u0940 \u091c\u0935\u093e\u092c \u092e\u0924 \u0926\u094b\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0926\u093f\u092f\u093e, \u0924\u094b \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0940\u0916 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0940 \u092c\u093e\u0930\u2026 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0906\u0917 \u0938\u0947 \u0926\u0942\u0930, \u0914\u0930 \u0905\u0902\u0926\u0930 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "start": 33.846
 },
 "b004": {
  "dur": 17.894,
  "text": "\u0914\u0930 \u092f\u0939\u0940 \u0939\u093f\u0938\u094d\u0938\u093e \u0930\u0939 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0905\u091c\u0928\u092c\u093f\u092f\u094b\u0902 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0941\u0915\u093e\u0930\u0924\u093e\u0964 \u092f\u0939 \u0909\u0938\u0940 \u0915\u094b \u092a\u0941\u0915\u093e\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u0918\u0930 \u0915\u0940 \u092f\u093e\u0926 \u0939\u094b\u0964 \u091c\u094b \u0909\u0938 \u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u092a\u0940\u091b\u0947 \u091a\u0932\u093e \u091c\u093e\u090f\u0964 \u092f\u0939 \u0936\u0930\u0940\u0930 \u0928\u0939\u0940\u0902, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091c\u0935\u093e\u092c \u0915\u093e \u0936\u093f\u0915\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964",
  "start": 51.986
 },
 "b005": {
  "dur": 14.105,
  "text": "\u0924\u094b \u092c\u0924\u093e\u0913\u0964 \u0915\u094d\u092f\u093e \u092f\u0939 \u0905\u0938\u0932\u0940 \u0939\u0948? \u0905\u0917\u0930 \u0939\u0948\u2026 \u0906\u091c \u0930\u093e\u0924 \u092f\u0939 \u0915\u0939\u093e\u0901 \u0938\u0947 \u092a\u0941\u0915\u093e\u0930 \u0930\u0939\u093e \u0939\u0948? \u0914\u0930 \u0905\u0917\u0930 \u092a\u0947\u0921\u093c\u094b\u0902 \u0938\u0947 \u092e\u093e\u0901 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u090f \u2014 \u0924\u094b \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u094d\u092f\u093e \u092a\u0942\u091b\u094b\u0917\u0947?",
  "start": 70.23
 }
