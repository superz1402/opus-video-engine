{
 "b001": {
  "dur": 15.307,
  "text": "\u0907\u0938 \u092b\u093c\u094b\u091f\u094b \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0926\u0947\u0916\u094b\u0964 \u092c\u093e\u0930\u093f\u0936 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0964 \u0924\u093e\u0907\u092a\u0947 \u0915\u0940 \u090f\u0915 \u0917\u0932\u0940 \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0930\u0947\u0938\u094d\u091f\u094b\u0930\u0947\u0902\u091f \u0939\u0948, \u0914\u0930 \u0936\u0940\u0936\u0947 \u0915\u0947 \u092a\u0940\u091b\u0947, \u090f\u0915 \u091f\u0947\u092c\u0932 \u092a\u0930, \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0940 \u0938\u092c\u0938\u0947 \u0915\u093c\u0940\u092e\u0924\u0940 \u0915\u0902\u092a\u0928\u0940 \u0915\u093e \u0938\u092c\u0938\u0947 \u0915\u093c\u0940\u092e\u0924\u0940 \u0906\u0926\u092e\u0940 \u092c\u0948\u0920\u093e \u0939\u0948\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 22.231,
  "text": "\u0921\u0947\u0922\u093c \u0938\u093e\u0932 \u092c\u093e\u0926, \u0935\u0939\u0940 \u092b\u093c\u094b\u091f\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u091c\u093e\u0901\u091a \u0915\u093e \u092a\u0939\u0932\u093e \u0938\u092c\u0942\u0924 \u092c\u0928 \u091c\u093e\u090f\u0917\u0940\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u0940 \u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u0938 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u2014 \u092f\u0939 \u0932\u0947\u0921\u0940 \u0915\u094b\u0908 \u0906\u092e \u092c\u093f\u091c\u093c\u0928\u0947\u0938\u0935\u0941\u092e\u0928 \u0928\u0939\u0940\u0902 \u0925\u0940\u0964 \u092f\u0939 \u091a\u0940\u0928 \u0915\u0940 \u091c\u093e\u0938\u0942\u0938\u0940 \u090f\u091c\u0947\u0902\u0938\u0940 \u0915\u0940 \u092d\u0947\u091c\u0940 \u0939\u0941\u0908 \u090f\u0915 \u090f\u091c\u0947\u0902\u091f \u0925\u0940\u0964 \u0914\u0930 \u0909\u0938\u0915\u093e \u0915\u093e\u092e \u0925\u093e \u2014 \u091c\u0947\u0928\u094d\u0938\u0947\u0928 \u0939\u0941\u0906\u0902\u0917 \u0915\u0947 \u0915\u093c\u0930\u0940\u092c \u091c\u093e\u0928\u093e\u0964",
  "start": 15.657
 }
