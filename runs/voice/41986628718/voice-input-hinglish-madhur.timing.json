  "text": "\u0914\u0930 \u092f\u0939\u0940 \u092a\u093e\u0930\u094d\u091f \u0915\u093f\u0938\u0940 \u0915\u094b \u092a\u0938\u0902\u0926 \u0928\u0939\u0940\u0902\u0964 \u0938\u094d\u0932\u0940\u092a \u092a\u0948\u0930\u093e\u0932\u093f\u0938\u093f\u0938 \u0938\u0940\u0928\u0947 \u0915\u093e \u0935\u0947\u091f \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u0947\u0928 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0915\u093f \u0905\u0928\u091c\u093e\u0928 \u0932\u094b\u0917\u2026 \u090f\u0915 \u0939\u0940 \u092b\u093c\u0947\u0938 \u0915\u094d\u092f\u094b\u0902 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
