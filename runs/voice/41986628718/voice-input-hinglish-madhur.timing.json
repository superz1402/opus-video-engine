  "text": "\u0926 \u0917\u094d\u0930\u0947\u0964 \u091b\u094b\u091f\u0940 \u0917\u094d\u0930\u0947 \u092c\u0949\u0921\u0940\u0964 \u092c\u0921\u093c\u0940 \u0915\u093e\u0932\u0940 \u0906\u0901\u0916\u0947\u0902 \u2014 \u0915\u092d\u0940 \u092c\u094d\u0932\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940\u0902\u0964 \u092f\u0947 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0906\u0924\u093e\u0964 \u092f\u0947 \u0935\u0939\u0940 \u0918\u0902\u091f\u0947 \u0932\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u093e\u0926 \u0928\u0939\u0940\u0902\u0964",
  "start": 8.832
 },
 "b003": {
  "dur": 18.312,
  "text": "1961 \u092e\u0947\u0902, \u092c\u0947\u091f\u094d\u091f\u0940 \u0914\u0930 \u092c\u093e\u0930\u094d\u0928\u0940 \u0939\u093f\u0932 \u092a\u0939\u093e\u0921\u093c\u094b\u0902 \u0938\u0947 \u0918\u0930 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947 \u2014 \u0914\u0930 \u0909\u0938 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u0947 \u0926\u094b \u0918\u0902\u091f\u0947 \u092c\u0938 \u0917\u093c\u093e\u092f\u092c \u0939\u094b \u0917\u090f\u0964 \u0939\u093f\u092a\u094d\u0928\u094b\u0938\u093f\u0938 \u092e\u0947\u0902, \u0926\u094b\u0928\u094b\u0902 \u0928\u0947 \u0935\u0939\u0940 \u092a\u0924\u0932\u0940 \u092b\u093c\u093f\u0917\u0930\u094d\u0938 \u092c\u0924\u093e\u0908\u0902\u0964 \u0935\u0939\u0940 \u092c\u0921\u093c\u0940 \u0906\u0901\u0916\u0947\u0902\u0964 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926, \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u091c\u0930\u094d\u0938 \u0928\u0947 \u0935\u0939\u0940 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u093e\u0908 \u0939\u0948\u0964",
  "start": 21.468
 },
 "b004": {
