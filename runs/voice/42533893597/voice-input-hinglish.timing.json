{
 "b001": {
  "dur": 23.174,
  "text": "\u0905\u0917\u0930 \u090f\u0915 \u092e\u0930\u093e \u0939\u0941\u0906 \u0906\u0926\u092e\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u092b\u093c \u092c\u0922\u093c\u0947 \u2014 \u0932\u0947\u0915\u093f\u0928 \u091a\u0932\u0947 \u0928\u0939\u0940\u0902, \u0915\u0942\u0926-\u0915\u0942\u0926 \u0915\u0930 \u0906\u090f \u2014 \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u0915\u0930\u094b\u0917\u0947? \u0938\u094b\u091a\u094b, \u0930\u093e\u0924 \u0917\u0939\u0930\u0940 \u0939\u0948, \u0914\u0930 \u0938\u0941\u0928\u0938\u093e\u0928 \u0938\u0921\u093c\u0915 \u092a\u0930 \u090f\u0915 \u0936\u0930\u0940\u0930 \u0938\u0940\u0927\u093e \u0916\u0921\u093c\u093e \u0939\u0948, \u092e\u093e\u0925\u0947 \u092a\u0930 \u090f\u0915 \u092a\u0940\u0932\u093e \u0915\u093e\u0917\u093c\u091c\u093c \u091a\u093f\u092a\u0915\u093e\u090f\u0964 \u0909\u0938\u0915\u0947 \u0939\u093e\u0925 \u0906\u0917\u0947 \u0915\u0940 \u0924\u0930\u092b\u093c \u0924\u0928\u0947 \u0939\u0941\u090f \u0939\u0948\u0902\u0964 \u0914\u0930 \u092b\u093f\u0930 \u2014 \u0935\u094b \u0939\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0915\u0942\u0926\u0964 \u092b\u093f\u0930 \u090f\u0915 \u0914\u0930\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 23.227,
  "text": "\u091c\u093f\u0906\u0902\u0917\u0936\u0940\u0964 \u092e\u0924\u0932\u092c: \u0905\u0915\u0921\u093c\u093e \u0939\u0941\u0906 \u0936\u0930\u0940\u0930 \u2014 '\u0938\u094d\u091f\u093f\u092b\u093c \u0915\u0949\u0930\u094d\u092a\u094d\u0938'\u0964 \u092f\u0947 \u092d\u0942\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0947 \u090f\u0915 \u0932\u093e\u0936 \u0939\u0948 \u091c\u094b \u091a\u0932 \u092a\u0921\u093c\u0940 \u0939\u0948\u0964 \u0909\u0938\u0915\u0947 \u0918\u0941\u091f\u0928\u0947 \u0928\u0939\u0940\u0902 \u092e\u0941\u0921\u093c\u0924\u0947, \u0915\u094b\u0939\u0928\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902 \u092e\u0941\u0921\u093c\u0924\u0940\u0902 \u2014 \u0907\u0938\u0940\u0932\u093f\u090f \u0935\u094b \u091a\u0932 \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u093e, \u0938\u093f\u0930\u094d\u092b\u093c \u0915\u0942\u0926 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u092a\u0941\u0930\u093e\u0928\u0947 \u091b\u093f\u0902\u0917 \u091c\u093c\u092e\u093e\u0928\u0947 \u0915\u0947 \u0926\u0930\u092c\u093e\u0930\u0940 \u0915\u092a\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0939\u094b\u0924\u093e \u0939\u0948, \u0917\u094b\u0932 \u091f\u094b\u092a\u0940 \u0915\u0947 \u0938\u093e\u0925 \u2014 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u090f\u0915 \u092e\u0930\u093e \u0939\u0941\u0906 \u0905\u092b\u093c\u0938\u0930\u0964",
  "start": 23.524
 },
 "b003": {
  "dur": 31.636,
  "text": "\u0907\u0938\u0915\u0940 \u091c\u0921\u093c \u090f\u0915 \u0905\u091c\u0940\u092c \u0938\u091a \u092e\u0947\u0902 \u091b\u0941\u092a\u0940 \u0939\u0948\u0964 \u091b\u093f\u0902\u0917 \u091c\u093c\u092e\u093e\u0928\u0947 \u092e\u0947\u0902 \u091c\u094b \u092e\u091c\u093c\u0926\u0942\u0930 \u0918\u0930 \u0938\u0947 \u0926\u0942\u0930 \u092e\u0930 \u091c\u093e\u0924\u0947 \u0925\u0947, \u0909\u0928\u0915\u0940 \u0932\u093e\u0936 \u0935\u093e\u092a\u0938 \u0932\u093e\u0928\u093e \u092e\u0939\u0901\u0917\u093e \u092a\u0921\u093c\u0924\u093e \u0925\u093e\u0964 \u0924\u094b \u0924\u093e\u0913\u0935\u093e\u0926\u0940 \u092a\u0941\u091c\u093e\u0930\u0940 \u0932\u093e\u0936\u094b\u0902 \u0915\u094b \u0930\u093e\u0924-\u0930\u093e\u0924 \u092d\u0930 '\u091a\u0932\u093e \u0915\u0930' \u0909\u0928\u0915\u0947 \u0917\u093e\u0901\u0935 \u092a\u0939\u0941\u0901\u091a\u093e\u0924\u0947 \u0925\u0947 \u2014 \u0918\u0902\u091f\u0940 \u092c\u091c\u093e\u0924\u0947 \u0939\u0941\u090f, \u0924\u093e\u0915\u093f \u0932\u094b\u0917 \u0930\u093e\u0938\u094d\u0924\u0947 \u0938\u0947 \u0939\u091f \u091c\u093e\u090f\u0901\u0964 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902, \u092c\u0901\u0927\u0940 \u0939\u0941\u0908 \u0932\u093e\u0936\u094b\u0902 \u0915\u0940 \u0935\u094b \u0915\u0942\u0926\u0924\u0940 \u0939\u0941\u0908 \u0915\u0924\u093e\u0930 \u0926\u0947\u0916 \u0915\u0930 \u0939\u0940 \u092f\u0947 \u0915\u0925\u093e \u091c\u0928\u094d\u092e\u0940\u0964 \u0967\u096d\u096e\u096e \u092e\u0947\u0902 \u092f\u0941\u0906\u0928 \u092e\u0947\u0908 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0915\u093f\u0924\u093e\u092c '\u091c\u093c\u0940 \u092c\u0942 \u092f\u0942' \u092e\u0947\u0902 \u0907\u0938\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0922\u0902\u0917 \u0938\u0947 \u0932\u093f\u0916\u093e\u0964",
  "start": 47.101
 },
 "b004": {
  "dur": 30.115,
  "text": "\u0909\u0938\u0947 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0909\u0938\u0942\u0932 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0938\u093e\u092b\u093c \u092c\u0924\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092a\u0940\u0932\u093e \u0924\u093e\u0935\u0940\u091c\u093c \u2014 \u0924\u093e\u0913\u0935\u093e\u0926\u0940 \u092e\u094b\u0939\u0930 \u0935\u093e\u0932\u093e \u0915\u093e\u0917\u093c\u091c\u093c \u2014 \u0905\u0917\u0930 \u0909\u0938\u0915\u0947 \u092e\u093e\u0925\u0947 \u092a\u0930 \u091a\u093f\u092a\u0915\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f, \u0935\u094b \u0935\u0939\u0940\u0902 \u091c\u092e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0926\u0947\u0916\u0924\u093e \u0928\u0939\u0940\u0902; \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u093e\u0901\u0938 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0940\u0932\u093f\u090f \u0915\u0925\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u093e \u0928\u0941\u0938\u094d\u0916\u093e \u0939\u0948: \u0938\u093e\u0901\u0938 \u0930\u094b\u0915 \u0932\u094b\u0964 \u091c\u092c \u0924\u0915 \u0938\u093e\u0901\u0938 \u0930\u0941\u0915\u0940 \u0939\u0948, \u0924\u0941\u092e \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0917\u093e\u092f\u092c \u0939\u094b\u0964 \u092e\u0941\u0930\u094d\u0917\u0947 \u0915\u0940 \u092c\u093e\u0901\u0917 \u0938\u0941\u092c\u0939 \u0915\u093e \u0910\u0932\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948, \u0914\u0930 \u092f\u0947 \u0905\u0902\u0927\u0947\u0930\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0935\u093e\u092a\u0938 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "start": 79.087
 },
 "b005": {
  "dur": 22.108,
  "text": "\u0924\u094b \u092c\u0924\u093e\u0913\u0964 \u0915\u094d\u092f\u093e \u091c\u093f\u0906\u0902\u0917\u0936\u0940 \u0930\u093f\u092f\u0932 \u0939\u0948? \u0905\u0917\u0930 \u0939\u0948 \u2014 \u0924\u094b \u0906\u091c \u0930\u093e\u0924 \u0935\u094b \u0915\u093f\u0938 \u0938\u0941\u0928\u0938\u093e\u0928 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u0915\u0942\u0926 \u0930\u0939\u093e \u0939\u094b\u0917\u093e? \u0914\u0930 \u0905\u0917\u0930 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u092e\u0928\u0947 \u0906 \u0916\u0921\u093c\u093e \u0939\u094b \u2014 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u092a\u0942\u091b\u094b\u0917\u0947? \u2026\u0938\u093e\u0901\u0938 \u0930\u094b\u0915 \u0932\u094b\u0964 \u0915\u0932 \u0930\u093e\u0924 \u0967\u0966: \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u093e \u0935\u094b \u092a\u0902\u0916 \u0935\u093e\u0932\u093e \u0906\u0926\u092e\u0940, \u091c\u094b \u0938\u092c \u0915\u0941\u091b \u0917\u0932\u0924 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0926\u093f\u0916\u093e \u0925\u093e\u0964",
  "start": 109.552
 }
