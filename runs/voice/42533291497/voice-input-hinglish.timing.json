{
 "b001": {
  "dur": 20.377,
  "text": "\u0938\u094b\u091a\u094b, \u0906\u092f\u0930\u0932\u0948\u0902\u0921 \u0915\u0947 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0947 \u0918\u0930 \u092e\u0947\u0902 \u0930\u093e\u0924 \u0915\u0947 \u0926\u094b \u092c\u091c\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0916\u093f\u0921\u093c\u0915\u0940 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0938\u0947 \u090f\u0915 \u0914\u0930\u0924 \u0915\u0947 \u0930\u094b\u0928\u0947 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0915\u094b\u0908 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0928\u0939\u0940\u0902 \u0916\u0941\u0932\u093e\u0964 \u0915\u094b\u0908 \u0939\u0949\u0938\u094d\u092a\u093f\u091f\u0932 \u0938\u0947 \u092b\u093c\u094b\u0928 \u0928\u0939\u0940\u0902 \u0906\u092f\u093e\u0964 \u092b\u093f\u0930 \u092d\u0940 \u092a\u0942\u0930\u093e \u0918\u0930 \u091c\u093e\u0917 \u0917\u092f\u093e \u0939\u0948 \u2014 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0938 \u0918\u0930 \u092e\u0947\u0902 \u0938\u092c \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902, \u092f\u0947 \u0906\u0935\u093e\u091c\u093c \u0916\u093c\u092c\u0930 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u0924\u0940 \u0939\u0948\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 24.097,
  "text": "\u092c\u0948\u0928\u094d\u0936\u0940\u0964 \u0906\u092f\u0930\u0932\u0948\u0902\u0921 \u0915\u0940 \u091c\u093c\u0941\u092c\u093e\u0928 \u092e\u0947\u0902 \u2014 \u092c\u0940\u0928 \u0936\u0940, \u092e\u0924\u0932\u092c \u092a\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u091f\u0940\u0932\u0947 \u0915\u0940 \u0914\u0930\u0924\u0964 \u0909\u0938\u0915\u093e \u0915\u093e\u092e \u092e\u094c\u0924 \u0932\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0909\u0938\u0915\u093e \u0915\u093e\u092e \u0939\u0948, \u092e\u094c\u0924 \u0915\u0940 \u0916\u093c\u092c\u0930 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u0941\u0928\u093e\u0928\u093e\u0964 \u0909\u0938\u0915\u0947 \u0932\u0902\u092c\u0947 \u092c\u093e\u0932 \u092c\u093f\u0916\u0930\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0905\u0915\u094d\u0938\u0930 \u0935\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u091a\u093e\u0901\u0926\u0940 \u0915\u0940 \u0915\u0902\u0918\u0940 \u0938\u0947 \u0915\u0902\u0918\u0940 \u0915\u0930\u0924\u0940 \u0939\u0941\u0908 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0964 \u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u0930\u094b\u0924\u0947-\u0930\u094b\u0924\u0947 \u0932\u093e\u0932 \u092a\u0921\u093c \u091a\u0941\u0915\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964",
  "start": 20.727
 },
 "b003": {
  "dur": 29.39,
  "text": "\u0909\u0938\u0915\u0940 \u091a\u0940\u0916 \u0906\u092f\u0930\u0932\u0948\u0902\u0921 \u092e\u0947\u0902 '\u0915\u0940\u0928\u093f\u0902\u0917' \u0915\u0939\u0932\u093e\u0924\u0940 \u0939\u0948 \u2014 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u094d\u0930\u0925\u093e, \u091c\u093f\u0938\u092e\u0947\u0902 \u0914\u0930\u0924\u0947\u0902 \u0915\u093f\u0938\u0940 \u0915\u0947 \u092e\u0930\u0928\u0947 \u092a\u0930 \u091c\u093c\u094b\u0930-\u091c\u093c\u094b\u0930 \u0938\u0947 \u0935\u093f\u0932\u093e\u092a \u0915\u0930\u0924\u0940 \u0925\u0940\u0902\u0964 \u092c\u0948\u0928\u094d\u0936\u0940 \u0909\u0938\u0940 \u0935\u093f\u0932\u093e\u092a \u0915\u093e \u092d\u0942\u0924-\u0930\u0942\u092a \u0939\u0948, \u091c\u094b \u092e\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u0948\u0928\u094d\u0936\u0940 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u093e \u0932\u093f\u0916\u093f\u0924 \u091c\u093c\u093f\u0915\u094d\u0930 \u0967\u0969\u096e\u0966 \u0915\u093e \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0930\u094b\u0924\u0940 \u2014 \u0938\u093f\u0930\u094d\u092b\u093c \u0906\u092f\u0930\u0932\u0948\u0902\u0921 \u0915\u0947 \u0915\u0941\u091b \u092a\u0941\u0930\u093e\u0928\u0947 \u0918\u0930\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f: \u0913\u0928\u0940\u0932, \u0913\u092c\u094d\u0930\u093e\u092f\u0928, \u0913\u0915\u094b\u0928\u094b\u0930, \u0913\u0917\u094d\u0930\u0947\u0921\u0940, \u0914\u0930 \u0915\u093e\u0935\u093e\u0928\u093e\u0918\u0964",
  "start": 45.174
 },
 "b004": {
  "dur": 23.983,
  "text": "\u0938\u092c\u0938\u0947 \u0905\u091c\u0940\u092c \u092c\u093e\u0924 \u092f\u0947 \u0939\u0948 \u2014 \u0935\u094b \u0926\u0942\u0930 \u092e\u0930\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0930\u094b\u0924\u0940 \u0939\u0948\u0964 \u0915\u094b\u0908 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u093e \u0906\u0926\u092e\u0940 \u0938\u092e\u0902\u0926\u0930 \u092a\u093e\u0930 \u092e\u0930 \u091c\u093e\u090f, \u0914\u0930 \u0916\u093c\u092c\u0930 \u0939\u092b\u093c\u094d\u0924\u0947 \u092d\u0930 \u092c\u093e\u0926 \u0906\u090f \u2014 \u092c\u0948\u0928\u094d\u0936\u0940 \u0909\u0938\u0940 \u0930\u093e\u0924 \u0930\u094b \u091a\u0941\u0915\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0909\u0938\u0947 \u0909\u0920\u093e\u0928\u093e \u092e\u0924 \u2014 \u0905\u0917\u0930 \u0930\u093e\u0938\u094d\u0924\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0915\u0902\u0918\u0940 \u092a\u0921\u093c\u0940 \u092e\u093f\u0932\u0947\u0964 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u0915\u0902\u0918\u0940 \u0909\u0938\u0915\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948 \u2014 \u0914\u0930 \u0909\u0938\u0915\u0940 \u091a\u0940\u091c\u093c \u0909\u0920\u093e\u0928\u093e, \u0909\u0938\u0915\u0940 \u0928\u091c\u093c\u0930 \u0905\u092a\u0928\u0940 \u0924\u0930\u092b\u093c \u092c\u0941\u0932\u093e\u0928\u093e \u0939\u0948\u0964",
  "start": 74.914
 },
 "b005": {
  "dur": 22.228,
  "text": "\u0924\u094b \u092c\u0924\u093e\u0913\u0964 \u0915\u094d\u092f\u093e \u092c\u0948\u0928\u094d\u0936\u0940 \u0930\u093f\u092f\u0932 \u0939\u0948? \u0905\u0917\u0930 \u0939\u0948 \u2014 \u0924\u094b \u0906\u091c \u0930\u093e\u0924 \u0935\u094b \u0915\u093f\u0938 \u092a\u0941\u0930\u093e\u0928\u0947 \u0918\u0930 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0930\u094b \u0930\u0939\u0940 \u0939\u094b\u0917\u0940? \u0914\u0930 \u0905\u0917\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0918\u0930 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0938\u0947 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0930\u094b\u0928\u0947 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u090f, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0915\u0947 \u2014 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u092a\u0942\u091b\u094b\u0917\u0947? \u2026\u0915\u0902\u0918\u0940 \u092e\u0924 \u0909\u0920\u093e\u0928\u093e\u0964 \u0915\u0932 \u0930\u093e\u0924 \u096f: \u091a\u0940\u0928 \u0915\u093e \u0935\u094b \u092e\u0930\u093e \u0939\u0941\u0906 \u0906\u0926\u092e\u0940, \u091c\u094b \u091a\u0932\u0924\u093e \u0928\u0939\u0940\u0902 \u2014 \u0915\u0942\u0926\u0924\u093e \u0939\u0948\u0964",
  "start": 99.247
 }
