{
 "b001": {
  "dur": 22.709,
  "text": "\u0938\u094b\u091a\u094b, \u0924\u0941\u092e \u092e\u0932\u0947\u0936\u093f\u092f\u093e \u0915\u0947 \u090f\u0915 \u0917\u093e\u0901\u0935 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0938\u0947 \u0917\u0941\u091c\u093c\u0930 \u0930\u0939\u0947 \u0939\u094b, \u0914\u0930 \u0939\u0935\u093e \u092e\u0947\u0902 \u0905\u091a\u093e\u0928\u0915 \u092b\u0942\u0932\u094b\u0902 \u0915\u0940 \u090f\u0915 \u092e\u0940\u0920\u0940 \u0938\u0940 \u0916\u0941\u0936\u092c\u0942 \u092d\u0930 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0915\u094b\u0908 \u092c\u093e\u0917\u093c \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092b\u093f\u0930 \u0915\u0947\u0932\u0947 \u0915\u0947 \u092a\u0947\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u0947 \u090f\u0915 \u0938\u092b\u093c\u0947\u0926 \u0938\u093e\u092f\u093e \u0939\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0932\u0902\u092c\u0947 \u0915\u093e\u0932\u0947 \u092c\u093e\u0932\u0964 \u0938\u092b\u093c\u0947\u0926 \u092a\u094b\u0936\u093e\u0915\u0964 \u0914\u0930 \u0935\u094b \u091c\u093c\u092e\u0940\u0928 \u0938\u0947 \u090f\u0915 \u0939\u093e\u0925 \u090a\u092a\u0930 \u2014 \u0924\u0948\u0930\u0924\u0940 \u0939\u0941\u0908\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 22.253,
  "text": "\u092a\u094b\u0902\u091f\u093f\u092f\u093e\u0928\u0915\u0964 \u092e\u0932\u092f \u091c\u093c\u0941\u092c\u093e\u0928 \u0915\u0947 \u090f\u0915 \u091c\u0941\u092e\u0932\u0947 \u0938\u0947 \u092c\u0928\u093e \u0928\u093e\u092e \u2014 '\u092a\u0947\u0930\u0947\u0902\u092a\u0941\u0906\u0928 \u092e\u093e\u0924\u0940 \u092c\u0947\u0930\u093e\u0928\u0915': \u0935\u094b \u0914\u0930\u0924 \u091c\u094b \u092c\u091a\u094d\u091a\u0947 \u0915\u094b \u091c\u0928\u094d\u092e \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u092e\u0930\u0940\u0964 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0909\u0938\u0915\u0940 \u0930\u0942\u0939 \u0935\u0939\u0940\u0902 \u0905\u091f\u0915\u0940 \u0930\u0939 \u091c\u093e\u0924\u0940 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0909\u0938\u0915\u0940 \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u0930\u0941\u0915\u0940 \u0925\u0940\u0964 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0935\u094b \u0915\u0947\u0932\u0947 \u0915\u0947 \u092a\u0947\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964 \u0930\u093e\u0924 \u092e\u0947\u0902 \u0935\u094b \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u0926\u092e\u093f\u092f\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0940 \u0924\u0930\u092b\u093c \u092c\u0941\u0932\u093e\u0924\u0940 \u0939\u0948\u0964",
  "start": 23.059
 },
 "b003": {
  "dur": 30.027,
  "text": "\u092f\u0947 \u0928\u093e\u092e \u0938\u093f\u0930\u094d\u092b\u093c \u0915\u0925\u093e\u0913\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e\u0964 \u0907\u0902\u0921\u094b\u0928\u0947\u0936\u093f\u092f\u093e \u0915\u0947 \u092c\u094b\u0930\u094d\u0928\u093f\u092f\u094b \u0926\u094d\u0935\u0940\u092a \u092a\u0930 \u090f\u0915 \u092a\u0942\u0930\u093e \u0936\u0939\u0930 \u0907\u0938\u0940 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u0948 \u2014 \u092a\u094b\u0902\u091f\u093f\u092f\u093e\u0928\u0915 \u0936\u0939\u0930\u0964 \u0967\u096d\u096d\u0967 \u092e\u0947\u0902 \u0938\u0941\u0932\u094d\u0924\u093e\u0928 \u0938\u094d\u092f\u093e\u0930\u093f\u092b\u093c \u0905\u092c\u094d\u0926\u0941\u0930\u094d\u0930\u0939\u092e\u093e\u0928 \u0935\u0939\u093e\u0901 \u092a\u0939\u0941\u0901\u091a\u0947, \u0924\u094b \u0915\u0925\u093e \u0915\u0939\u0924\u0940 \u0939\u0948, \u0909\u0938 \u0935\u0940\u0930\u093e\u0928 \u0928\u0926\u0940-\u092e\u0941\u0939\u093e\u0928\u0947 \u092a\u0930 \u0907\u0928 \u0906\u0924\u094d\u092e\u093e\u0913\u0902 \u0915\u093e \u0921\u0947\u0930\u093e \u0925\u093e\u0964 \u0924\u094b\u092a\u094b\u0902 \u0915\u0940 \u0917\u094b\u0932\u093f\u092f\u093e\u0901 \u091a\u0932\u093e\u0908 \u0917\u0908\u0902, \u091c\u0917\u0939 \u0938\u093e\u092b\u093c \u0939\u0941\u0908 \u2014 \u0914\u0930 \u0935\u0939\u093e\u0901 \u092e\u0938\u094d\u091c\u093f\u0926 \u0914\u0930 \u092e\u0939\u0932 \u092c\u0928\u093e\u0964 \u0906\u091c \u0935\u094b \u0936\u0939\u0930 \u090f\u0915 \u092a\u094d\u0930\u093e\u0902\u0924 \u0915\u0940 \u0930\u093e\u091c\u0927\u093e\u0928\u0940 \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u090f\u0915 \u092d\u0942\u0924 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u0948\u0964",
  "start": 45.662
 },
 "b004": {
  "dur": 29.944,
  "text": "\u0909\u0938\u0947 \u0930\u094b\u0915\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u092e\u0932\u092f \u0915\u0925\u093e\u090f\u0901 \u090f\u0915 \u0905\u091c\u0940\u092c \u0938\u0947 \u0909\u0938\u0942\u0932 \u0938\u0947 \u091c\u094b\u0921\u093c\u0924\u0940 \u0939\u0948\u0902\u0964 \u0909\u0938\u0915\u0947 \u0917\u0932\u0947 \u0915\u0947 \u092a\u0940\u091b\u0947, \u092c\u093e\u0932\u094b\u0902 \u0915\u0947 \u0928\u0940\u091a\u0947, \u090f\u0915 \u091b\u0947\u0926 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0909\u0938\u092e\u0947\u0902 \u0932\u094b\u0939\u0947 \u0915\u0940 \u0915\u0940\u0932 \u0920\u094b\u0915 \u0926\u0940 \u091c\u093e\u090f \u2014 \u0924\u094b \u0935\u094b \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0916\u0942\u092c\u0938\u0942\u0930\u0924, \u0936\u093e\u0902\u0924, \u090f\u0915 \u0906\u092e \u0914\u0930\u0924 \u0915\u0940 \u0924\u0930\u0939 \u0930\u0939\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964 \u091c\u092c \u0924\u0915 \u0915\u0940\u0932 \u0935\u0939\u0940\u0902 \u0930\u0939\u0947\u0964 \u091c\u093f\u0938 \u0926\u093f\u0928 \u0915\u0940\u0932 \u0928\u093f\u0915\u0932\u0940 \u2014 \u0909\u0938\u0940 \u0926\u093f\u0928 \u0915\u0925\u093e \u092b\u093f\u0930 \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0940\u0932\u093f\u090f \u092a\u0941\u0930\u093e\u0928\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0915\u0939\u0924\u0940 \u0939\u0948\u0902 \u2014 \u0915\u0940\u0932 \u0915\u094b \u0915\u092d\u0940 \u0939\u093e\u0925 \u092e\u0924 \u0932\u0917\u093e\u0928\u093e\u0964",
  "start": 76.039
 },
 "b005": {
  "dur": 21.528,
  "text": "\u0924\u094b \u092c\u0924\u093e\u0913\u0964 \u0915\u094d\u092f\u093e \u092a\u094b\u0902\u091f\u093f\u092f\u093e\u0928\u0915 \u0930\u093f\u092f\u0932 \u0939\u0948? \u0905\u0917\u0930 \u0939\u0948 \u2014 \u0924\u094b \u0906\u091c \u0930\u093e\u0924 \u0935\u094b \u0915\u093f\u0938 \u0915\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0917\u093c \u092e\u0947\u0902 \u0939\u094b\u0917\u0940? \u0914\u0930 \u0905\u0917\u0930 \u0939\u0935\u093e \u092e\u0947\u0902 \u092b\u0942\u0932\u094b\u0902 \u0915\u0940 \u0916\u0941\u0936\u092c\u0942 \u0905\u091a\u093e\u0928\u0915 \u092c\u0922\u093c \u091c\u093e\u090f \u2014 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u092a\u0942\u091b\u094b\u0917\u0947? \u2026\u0915\u0940\u0932 \u0915\u094b \u0939\u093e\u0925 \u092e\u0924 \u0932\u0917\u093e\u0928\u093e\u0964 \u0915\u0932 \u0930\u093e\u0924 \u0967\u0969: \u091c\u093e\u092a\u093e\u0928 \u0915\u0940 \u0935\u094b \u0930\u0942\u0939, \u091c\u093f\u0938\u0915\u093e \u092c\u0926\u0932\u093e \u0915\u092d\u0940 \u0925\u0915\u0924\u093e \u0928\u0939\u0940\u0902\u0964",
  "start": 106.333
 }
