{
 "b001": {
  "dur": 16.312,
  "text": "\u0938\u094b\u091a\u094b, \u0924\u0941\u092e \u0930\u093e\u0924 \u0915\u0947 \u0926\u094b \u092c\u091c\u0947 \u0905\u0915\u0947\u0932\u0947 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u0930\u0915\u0947 \u0918\u0930 \u091c\u093e \u0930\u0939\u0947 \u0939\u094b\u2026 \u0914\u0930 \u090f\u0915 \u0915\u093e\u0932\u093e \u0915\u0941\u0924\u094d\u0924\u093e \u0916\u093c\u093e\u0932\u0940 \u0938\u0921\u093c\u0915 \u0915\u0947 \u092c\u0940\u091a \u092e\u0947\u0902 \u092c\u0948\u0920\u093e \u0939\u0948? \u0915\u094d\u0930\u0949\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e\u0964 \u0939\u093f\u0932 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e\u0964 \u092c\u0938 \u092c\u0948\u0920\u093e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u093e\u0930 \u0915\u094b \u0906\u0924\u093e \u0926\u0947\u0916 \u0930\u0939\u093e \u0939\u0948\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 17.497,
  "text": "\u0926 \u092c\u094d\u0932\u0948\u0915 \u0921\u0949\u0917\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u0949\u0930\u094d\u092e\u0932 \u0915\u0941\u0924\u094d\u0924\u0947 \u0938\u0947 \u0915\u093e\u092b\u093c\u0940 \u092c\u0921\u093c\u093e\u0964 \u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u092a\u0915\u0921\u093c \u0932\u0947\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0915\u092d\u0940 \u0915\u093e\u0930 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0928\u0939\u0940\u0902 \u092d\u093e\u0917\u0924\u093e\u0964 \u0915\u092d\u0940 \u092d\u093e\u0917\u0924\u093e \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u092f\u0947 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0935\u0939\u093e\u0901 \u0925\u093e \u2014 \u092f\u0947 \u0935\u0947\u091f \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964",
  "start": 16.662
 },
 "b003": {
  "dur": 20.155,
  "text": "\u0938\u0947\u0902\u091a\u0941\u0930\u0940\u091c\u093c \u0938\u0947, \u092c\u094d\u0930\u093f\u091f\u0947\u0928 \u092e\u0947\u0902 \u091f\u094d\u0930\u0948\u0935\u0932\u0930\u094d\u0938 \u0915\u094b \u092f\u0947 \u0930\u093e\u0924 \u0915\u0940 \u0938\u0921\u093c\u0915\u094b\u0902 \u092a\u0930 \u092e\u093f\u0932\u093e \u0939\u0948\u0964 1577 \u092e\u0947\u0902, \u090f\u0915 \u0924\u0942\u092b\u093c\u093e\u0928 \u0915\u0947 \u091f\u093e\u0907\u092e \u092f\u0947 \u092c\u0902\u0917\u0940 \u0915\u0947 \u091a\u0930\u094d\u091a \u092e\u0947\u0902 \u0918\u0941\u0938 \u0917\u092f\u093e \u0925\u093e \u2014 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092a\u0902\u091c\u094b\u0902 \u0915\u0947 \u0928\u093f\u0936\u093e\u0928 \u0906\u091c \u092d\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u092a\u0930 \u091c\u0932\u0947 \u0939\u0941\u090f \u0939\u0948\u0902\u0964 \u0932\u094b\u0917 \u0909\u0938\u0947 \u092c\u094d\u0932\u0948\u0915 \u0936\u0915 \u0915\u0939\u0924\u0947 \u0925\u0947\u0964 \u0936\u0948\u0924\u093e\u0928 \u0915\u093e \u0915\u0941\u0924\u094d\u0924\u093e\u0964",
  "start": 34.509
 },
 "b004": {
  "dur": 20.113,
  "text": "\u0914\u0930 \u092f\u0939\u0940 \u092a\u093e\u0930\u094d\u091f \u0938\u093e\u0925 \u0930\u0939 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0907\u0938\u0947 \u0906\u0924\u0947 \u0939\u0941\u090f \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u093e\u0964 \u0915\u093f\u0938\u0940 \u0928\u0947 \u091c\u093e\u0924\u0947 \u0939\u0941\u090f \u092d\u0940 \u0928\u0939\u0940\u0902\u0964 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094d\u0938 \u0915\u094b \u092f\u0947 \u0909\u0928 \u0938\u0921\u093c\u0915\u094b\u0902 \u092a\u0930 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u091c\u0939\u093e\u0901 \u0935\u094b \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0905\u0915\u0947\u0932\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0921\u093c\u0915 \u0915\u094d\u0930\u0949\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e\u0964 \u0924\u0941\u092e \u0909\u0938\u0915\u0940 \u0938\u0921\u093c\u0915 \u0915\u094d\u0930\u0949\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0964",
