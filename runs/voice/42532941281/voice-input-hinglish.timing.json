{
 "b001": {
  "dur": 22.29,
  "text": "\u0938\u094b\u091a\u094b, \u0967\u096f\u096c\u096c \u0915\u0940 \u090f\u0915 \u0928\u0935\u0902\u092c\u0930 \u0930\u093e\u0924 \u0939\u0948\u0964 \u0926\u094b \u0928\u094c\u091c\u0935\u093e\u0928 \u091c\u094b\u0921\u093c\u0947 \u090f\u0915 \u0915\u093e\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0935\u0940\u0930\u093e\u0928 \u092b\u093c\u0948\u0915\u094d\u091f\u094d\u0930\u0940 \u0907\u0932\u093e\u0915\u0947 \u0938\u0947 \u0917\u0941\u091c\u093c\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u2014 \u091c\u093f\u0938\u0947 \u0932\u094b\u0917 \u091f\u0940\u090f\u0928\u091f\u0940 \u090f\u0930\u093f\u092f\u093e \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u092d\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u092e\u0947\u0902 \u0935\u094b \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u0906\u0926\u092e\u0940 \u091c\u0948\u0938\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u0926\u092e\u0940 \u0938\u0947 \u0932\u0902\u092c\u093e\u0964 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092a\u0940\u091b\u0947 \u2014 \u092a\u0902\u0916\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 24.482,
  "text": "\u092e\u094b\u0925\u092e\u0948\u0928\u0964 \u092a\u0949\u0907\u0902\u091f \u092a\u094d\u0932\u0947\u091c\u093c\u0947\u0902\u091f, \u0935\u0947\u0938\u094d\u091f \u0935\u0930\u094d\u091c\u0940\u0928\u093f\u092f\u093e \u0915\u0940 \u0909\u0938 \u0930\u093e\u0924 \u0915\u0947 \u092c\u093e\u0926 \u092f\u0947 \u0928\u093e\u092e \u0926\u0941\u0928\u093f\u092f\u093e \u092d\u0930 \u092e\u0947\u0902 \u092b\u0948\u0932 \u0917\u092f\u093e\u0964 \u0917\u0935\u093e\u0939\u094b\u0902 \u0928\u0947 \u0909\u0938\u0947 \u096c-\u096d \u092b\u093c\u0940\u091f \u0932\u0902\u092c\u093e \u092c\u0924\u093e\u092f\u093e \u2014 \u092d\u0942\u0930\u093e-\u0938\u092b\u093c\u0947\u0926 \u0936\u0930\u0940\u0930, \u0967\u0966 \u092b\u093c\u0940\u091f \u0924\u0915 \u092b\u0948\u0932\u093e \u092a\u0902\u0916, \u0914\u0930 \u0926\u094b \u092c\u0921\u093c\u0940, \u091c\u0932\u0924\u0940 \u0939\u0941\u0908 \u0932\u093e\u0932 \u0906\u0901\u0916\u0947\u0902\u0964 \u0909\u0938\u0928\u0947 \u0915\u093e\u0930 \u0915\u093e \u092a\u0940\u091b\u093e \u0915\u093f\u092f\u093e, \u0924\u0947\u091c\u093c \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u092a\u0930 \u092d\u0940 \u0938\u093e\u0925 \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c\u093e\u0964 \u091a\u093e\u0930\u094b\u0902 \u0917\u0935\u093e\u0939 \u092a\u0939\u0932\u0947 \u092a\u0941\u0932\u093f\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0917\u090f, \u092b\u093f\u0930 \u0905\u0916\u093c\u092c\u093e\u0930 \u0915\u0947\u0964",
  "start": 22.64
 },
 "b003": {
  "dur": 23.143,
  "text": "\u0935\u094b \u0905\u0915\u0947\u0932\u093e \u0935\u093e\u0915\u093c\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0905\u0917\u0932\u0947 \u0967\u0969 \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u0909\u0938 \u0907\u0932\u093e\u0915\u0947 \u092e\u0947\u0902 \u0967\u0966\u0966 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0909\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u094b \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e\u0964 \u0915\u0941\u091b \u091c\u0940\u0935-\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915\u094b\u0902 \u0928\u0947 \u0938\u092e\u091d\u093e\u092f\u093e \u2014 \u092f\u0947 \u090f\u0915 \u092c\u0921\u093c\u093e \u0938\u093e\u0930\u0938 \u092a\u0915\u094d\u0937\u0940 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u0930\u094b\u0936\u0928\u0940 \u092e\u0947\u0902 \u0932\u093e\u0932 \u091a\u092e\u0915\u0924\u0940 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0926\u093e\u0935\u0947 \u092b\u093f\u0930 \u092d\u0940 \u0906\u0924\u0947 \u0930\u0939\u0947\u0964 \u0914\u0930 \u092b\u093f\u0930 \u0906\u0908 \u0926\u093f\u0938\u0902\u092c\u0930 \u0967\u096f\u096c\u096d\u0964",
  "start": 47.472
 },
 "b004": {
  "dur": 34.321,
  "text": "\u0967\u096b \u0926\u093f\u0938\u0902\u092c\u0930 \u0967\u096f\u096c\u096d, \u0936\u093e\u092e \u0915\u0947 \u0930\u0936 \u0906\u0935\u0930 \u092e\u0947\u0902, \u0913\u0939\u093e\u092f\u094b \u0928\u0926\u0940 \u092a\u0930 \u092c\u0928\u093e \u0938\u093f\u0932\u094d\u0935\u0930 \u092c\u094d\u0930\u093f\u091c \u0905\u091a\u093e\u0928\u0915 \u0917\u093f\u0930 \u0917\u092f\u093e\u0964 \u096a\u096c \u0932\u094b\u0917 \u092e\u093e\u0930\u0947 \u0917\u090f\u0964 \u0924\u0939\u0915\u093c\u0940\u0915\u093c \u0928\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0938\u093e\u092b\u093c \u092c\u0924\u093e\u092f\u093e \u2014 \u092a\u0941\u0932 \u0915\u0940 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0940 \u0932\u094b\u0939\u0947 \u0915\u0940 \u0915\u0921\u093c\u0940 \u0905\u0902\u0926\u0930 \u0938\u0947 \u0918\u093f\u0938 \u091a\u0941\u0915\u0940 \u0925\u0940; \u092f\u0939\u0940 \u0911\u092b\u093c\u093f\u0936\u093f\u092f\u0932 \u0935\u091c\u0939 \u0925\u0940\u0964 \u0932\u0947\u0915\u093f\u0928 \u092a\u0949\u0907\u0902\u091f \u092a\u094d\u0932\u0947\u091c\u093c\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0909\u0938\u0940 \u0926\u093f\u0928 \u0930\u0941\u0915 \u0917\u092f\u093e\u0964 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0935\u094b \u092a\u0902\u0916 \u0935\u093e\u0932\u093e \u0906\u0926\u092e\u0940 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0964 \u0967\u096f\u096d\u096b \u092e\u0947\u0902 \u091c\u0949\u0928 \u0915\u0940\u0932 \u0915\u0940 \u0915\u093f\u0924\u093e\u092c '\u0926 \u092e\u094b\u0925\u092e\u0948\u0928 \u092a\u094d\u0930\u094b\u092b\u093c\u0947\u0938\u0940\u091c\u093c' \u0928\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0925\u093e\u0913\u0902 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u091c\u094b\u0921\u093c \u0926\u093f\u092f\u093e \u2014 \u091a\u0947\u0924\u093e\u0935\u0928\u0940, \u0914\u0930 \u0939\u093e\u0926\u0938\u093e\u0964",
  "start": 70.965
 },
 "b005": {
  "dur": 20.353,
  "text": "\u0924\u094b \u092c\u0924\u093e\u0913\u0964 \u0915\u094d\u092f\u093e \u092e\u094b\u0925\u092e\u0948\u0928 \u0930\u093f\u092f\u0932 \u0939\u0948? \u0905\u0917\u0930 \u0939\u0948 \u2014 \u0924\u094b \u0967\u096f\u096c\u096d \u0915\u0947 \u092c\u093e\u0926 \u0935\u094b \u0917\u092f\u093e \u0915\u0939\u093e\u0901? \u0914\u0930 \u0905\u0917\u0930 \u0915\u0932 \u0930\u093e\u0924 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u093e\u0930 \u0915\u0940 \u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u092e\u0947\u0902 \u0906 \u0916\u0921\u093c\u093e \u0939\u094b \u2014 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u092a\u0942\u091b\u094b\u0917\u0947? \u2026\u0939\u0947\u0921\u0932\u093e\u0907\u091f\u094d\u0938 \u091c\u0932\u093e \u0915\u0930 \u0926\u0947\u0916\u094b\u0964 \u0915\u0932 \u0930\u093e\u0924 \u0967\u0967: \u092b\u093c\u093f\u0932\u0940\u092a\u0940\u0902\u0938 \u0915\u0940 \u0935\u094b \u0914\u0930\u0924, \u091c\u094b \u0906\u0927\u0940 \u0909\u0921\u093c\u0924\u0940 \u0939\u0948\u0964",
  "start": 105.636
 }
