{
 "b001": {
  "dur": 11.951,
  "text": "\u0938\u094b\u091a\u094b, \u0924\u0941\u092e \u0921\u0940\u092a \u091c\u0902\u0917\u0932 \u092e\u0947\u0902 \u0917\u090f \u0939\u094b\u2026 \u0914\u0930 \u0905\u0901\u0927\u0947\u0930\u093e \u0939\u094b\u0924\u0947 \u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092e\u092e\u094d\u092e\u0940 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0924\u0940 \u0939\u0948 \u2014 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092a\u0941\u0915\u093e\u0930\u0924\u0940 \u0939\u0941\u0908\u0964 \u0932\u0947\u0915\u093f\u0928 \u092e\u092e\u094d\u092e\u0940 \u0924\u094b \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u092e\u0940\u0932 \u0926\u0942\u0930 \u0939\u0948\u0964",
  "start": 0.0
 },
 "b002": {
  "dur": 17.079,
  "text": "\u0926 \u092e\u093f\u092e\u093f\u0915\u0964 \u0907\u0938\u0915\u093e \u0905\u092a\u0928\u093e \u0915\u094b\u0908 \u092b\u093c\u0947\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u0907\u0938\u0932\u093f\u090f \u092f\u0947 \u0935\u0939\u0940 \u091a\u0940\u091c\u093c \u092c\u0949\u0930\u094b \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u094b \u0907\u0938\u0947 \u091a\u093e\u0939\u093f\u090f \u2014 \u090f\u0915 \u0906\u0935\u093e\u091c\u093c \u091c\u093f\u0938\u0947 \u0924\u0941\u092e \u091f\u094d\u0930\u0938\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u094b\u0964 \u092f\u0947 \u0926\u093f\u0928 \u092d\u0930 \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u0938\u0940\u0916\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u0905\u092a\u0928\u0947 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0915\u0948\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948\u0964",
  "start": 12.301
 },
 "b003": {
  "dur": 17.937,
  "text": "\u0924\u0940\u0928 \u0915\u0949\u0928\u094d\u091f\u093f\u0928\u0947\u0902\u091f\u094d\u0938 \u0915\u0947 \u091c\u0902\u0917\u0932\u094d\u0938 \u092e\u0947\u0902 \u090f\u0915 \u0939\u0940 \u0935\u093e\u0930\u094d\u0928\u093f\u0902\u0917 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948: \u092a\u0947\u0921\u093c\u094b\u0902 \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092a\u0941\u0915\u093e\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u092d\u0940 \u0930\u093f\u092a\u094d\u0932\u093e\u0908 \u092e\u0924 \u0926\u094b\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0930\u093f\u092a\u094d\u0932\u093e\u0908 \u0926\u093f\u092f\u093e, \u0924\u094b \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0940\u0916 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0940 \u092c\u093e\u0930\u2026 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0906\u0917 \u0938\u0947 \u0926\u0942\u0930, \u0914\u0930 \u0905\u0902\u0926\u0930 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "start": 29.73
 },
 "b004": {
  "dur": 16.562,
  "text": "\u0914\u0930 \u092f\u0939\u0940 \u092a\u093e\u0930\u094d\u091f \u0938\u093e\u0925 \u0930\u0939 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u091c\u0930\u094d\u0938 \u0915\u094b \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092a\u0941\u0915\u093e\u0930\u0924\u093e\u0964 \u092f\u0947 \u0909\u0938\u0940 \u0915\u094b \u092a\u0941\u0915\u093e\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0947 \u0918\u0930 \u0915\u0940 \u092f\u093e\u0926 \u0939\u094b\u0964 \u091c\u094b \u0909\u0938 \u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u092a\u0940\u091b\u0947 \u091a\u0932\u093e \u091c\u093e\u090f\u0964 \u092f\u0947 \u092c\u0949\u0921\u0940 \u0928\u0939\u0940\u0902, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0930\u093f\u092a\u094d\u0932\u093e\u0908 \u0915\u093e \u0936\u093f\u0915\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964",
  "start": 48.017
 },
 "b005": {
