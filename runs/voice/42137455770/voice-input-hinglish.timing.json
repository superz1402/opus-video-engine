{
 "b003": {
  "dur": 1.464,
  "text": "\u0936\u093f\u0915\u093e\u0917\u094b, 1930s\u0964 \u0906\u0930\u094d\u091a\u0930 \u090f\u0935\u0947\u0928\u094d\u092f\u0942 \u092a\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094d\u0938 \u090f\u0915 \u092f\u0902\u0917 \u0914\u0930\u0924 \u0915\u094b \u0932\u093f\u092b\u093c\u094d\u091f \u0926\u0947\u0924\u0947 \u0930\u0939\u0947 \u2014 \u0938\u092b\u093c\u0947\u0926 \u0917\u093e\u0909\u0928 \u092e\u0947\u0902\u0964 \u0935\u094b \u0915\u0939\u0924\u0940, \u092e\u0941\u091d\u0947 \u0918\u0930 \u091b\u094b\u0921\u093c \u0926\u094b \u2014 \u0914\u0930 \u0930\u0947\u091c\u093c\u0930\u0947\u0915\u094d\u0936\u0928 \u0938\u093f\u092e\u0947\u091f\u094d\u0930\u0940 \u0915\u0947 \u092c\u093e\u0939\u0930 \u0917\u093c\u093e\u092f\u092c \u0939\u094b \u091c\u093e\u0924\u0940\u0964 \u0932\u094b\u0917 \u0909\u0938\u0947 \u0930\u0947\u091c\u093c\u0930\u0947\u0915\u094d\u0936\u0928 \u092e\u0948\u0930\u0940 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0947\u0915\u094d\u0938\u093f\u0915\u094b \u092e\u0947\u0902 \u092f\u0947 \u0915\u0939\u093e\u0928\u0940 \u0914\u0930 \u092a\u0941\u0930\u093e\u0928\u0940 \u0939\u0948: \u0932\u093e \u0932\u094b\u0930\u094b\u0928\u093e, \u0928\u0926\u0940 \u0915\u093f\u0928\u093e\u0930\u0947 \u0930\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0914\u0930\u0924, \u0905\u092a\u0928\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u094b \u0922\u0942\u0901\u0922 \u0930\u0939\u0940 \u0939\u0948\u0964"
 }
}