 "subs": [
  {
   "t0": 4.02,
   "t1": 7.49,
   "text": "Is photo ko dhyaan se dekho Baarish ho rahi"
  },
  {
   "t0": 7.53,
   "t1": 11.31,
   "text": "hai Taipei ki ek gali mein ek chhota sa restaurant"
  },
  {
   "t0": 11.35,
   "t1": 14.72,
   "text": "hai aur sheeshe ke peeche ek table par duniya"
  },
  {
   "t0": 14.76,
   "t1": 18.98,
   "text": "ki sabse keemti company ka sabse keemti aadmi baitha hai"
  },
  {
   "t0": 19.02,
   "t1": 23.08,
   "text": "Uske saath ek lady hai Gulabi dress mein"
  },
  {
   "t0": 23.17,
   "t1": 26.55,
   "text": "Woh uske kandhe par haath rakhti hai uske kaan mein kuch kehti"
  },
  {
   "t0": 26.59,
   "t1": 30.28,
   "text": "hai aur uske gaal par ek kiss karti hai Dinner"
  },
  {
   "t0": 30.32,
   "t1": 33.64,
   "text": "khatam hota hai toh woh aadmi darwaze par ruk kar ek client"
  },
  {
   "t0": 33.68,
   "t1": 37.8,
   "text": "ko alvida kehta hai aur woh lady intezaar nahi karti"
  },
  {
   "t0": 37.89,
   "t1": 41.32,
   "text": "Woh seedha jaakar uski gaadi mein baith jaati hai"
  },
  {
   "t0": 43.02,
   "t1": 46.62,
   "text": "Us raat Taiwan ki khabar sirf itni thi Jensen Huang"
  },
  {
   "t0": 46.66,
   "t1": 50.44,
   "text": "ne baarish mein khade reporters ko fried rice baanta tha"
  },
  {
   "t0": 52.02,
   "t1": 55.43,
   "text": "Dedh saal baad wahi photo duniya ki sabse badi"
  },
  {
   "t0": 55.47,
   "t1": 58.95,
   "text": "jaanch ka pehla saboot ban jaayegi Kyunki"
  },
  {
   "t0": 58.99,
   "t1": 62.38,
   "text": "America ki intelligence ka kehna hai yeh lady koi"
  },
  {
   "t0": 62.42,
   "t1": 65.76,
   "text": "aam businesswoman nahi thi Yeh China ki"
  },
  {
   "t0": 65.8,
   "t1": 69.61,
   "text": "jasusi agency ki bheji hui ek agent thi Aur"
  },
  {
   "t0": 69.65,
   "t1": 72.98,
   "text": "uska kaam tha Jensen Huang ke kareeb jaana"
  },
  {
   "t0": 73.02,
   "t1": 77.49,
   "text": "Lekin ruko Yeh film faisla nahi sunayegi"
  },
  {
   "t0": 77.6,
   "t1": 80.89,
   "text": "Yeh film saboot ko ek table par rakhegi ek-ek"
  },
  {
   "t0": 80.93,
   "t1": 84.63,
   "text": "karke ek hi ghadi par aur tum khud dekhoge kya"
  },
  {
   "t0": 84.67,
   "t1": 88.4,
   "text": "sach mein record par hai aur kya sirf kaha gaya hai"
  },
  {
   "t0": 88.52,
   "t1": 92.06,
   "text": "Is hisse ka connection is kahani se isliye hai kyunki aage"
  },
  {
   "t0": 92.1,
   "t1": 95.84,
   "text": "jo kuch bhi tum dekhoge har photo har kagaz"
  },
  {
   "t0": 95.88,
   "t1": 100.35,
   "text": "har aarop uska wazan inhi chaar khano se tay hoga"
  },
  {
   "t0": 100.43,
   "t1": 104.36,
   "text": "Yeh do minute aage ke athais minute ki neev hain"
  }
 ],
